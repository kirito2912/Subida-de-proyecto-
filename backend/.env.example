# ─── Backend (.env en /backend) ──────────────────────────────────────────────
# Copia este archivo como .env y rellena los valores

# Base de datos
# Local (SQLite):
DATABASE_URL=sqlite:///./cortinasys.db
# Producción (Render PostgreSQL):
# DATABASE_URL=postgresql://user:password@host:5432/cortinasys

# CORS — dominios del frontend separados por coma
# Local:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Producción (agrega tu dominio de Vercel):
# ALLOWED_ORIGINS=https://tu-app.vercel.app,http://localhost:5173
